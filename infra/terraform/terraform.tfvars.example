# 실제 값으로 채운 뒤 `terraform.tfvars` 로 복사 (이 파일은 .gitignore 됨).
# 민감값(db_password 등)은 깃에 올리지 말 것 — 환경변수 TF_VAR_db_password 로 넣어도 됨.

region         = "ap-northeast-2"
project        = "khu-global-hub"

ec2_ami        = "ami-xxxxxxxxxxxxxxxxx" # 현재 인스턴스 AMI
ec2_key_name   = "your-keypair-name"
s3_bucket_name = "your-image-bucket-name"

db_username    = "REDACTED"
db_password    = "REDACTED"

my_ip_cidr     = "0.0.0.0/0" # 운영은 본인 IP/32 로 좁힐 것
