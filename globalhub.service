[Unit]
Description=KHU GlobalHub Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/bin/bash -c 'set -a; source /home/ubuntu/.env; set +a; exec java -Xmx420m -jar /home/ubuntu/app.jar --spring.profiles.active=prod --spring.jpa.hibernate.ddl-auto=update'
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
