# 로컬 개발용 설정 예시 파일.
# 이 파일을 같은 폴더에 application-local.yml 로 복사해서 사용하세요.
#   (application-local.yml 은 .gitignore 처리되어 있어 git에 올라가지 않습니다)
#
# 아래 DB 접속 정보는 docker-compose.yml 의 로컬 PostgreSQL 과 동일한 더미 값입니다.
# 민감 정보 아님 — 그대로 사용하면 됩니다.

spring:
  datasource:
    url: jdbc:postgresql://localhost:5433/khu_global_hub   # docker-compose 포트(5433)와 일치
    username: globalhub
    password: globalhub1234

  jpa:
    hibernate:
      ddl-auto: create   # 앱 재시작 시마다 테이블 초기화. 데이터 유지하려면 update 로 변경
    show-sql: true
